# このファイルを `client/.env` にコピーして値を設定してください。実際の `.env` はコミットしないこと。
# 注意: ブラウザに公開される変数は `REACT_APP_` プレフィックスが必要（Create React App の仕様）

# クライアントのポート番号
PORT=3000

# バックエンド API のエンドポイント
REACT_APP_API_URL=http://localhost:4000

# Google Maps JavaScript API Key（クライアント側の地図描画に使用）
# ブラウザに公開されるため、Google Cloud コンソールで HTTP リファラー制限をかけること
REACT_APP_GOOGLE_MAPS_API_KEY=取得したAPIキーをここに貼り付け

# 開発環境で HTTPS を有効にする（位置情報APIなどに必要）
HTTPS=true

# 本番ビルドでソースマップを無効化（バンドルサイズ削減）
GENERATE_SOURCEMAP=false

# 開発時のホストチェック無効化（ngrok等のトンネル利用時に必要）
DANGEROUSLY_DISABLE_HOST_CHECK=true
