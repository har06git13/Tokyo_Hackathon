# このファイルを `server/.env` にコピーして値を設定してください。実際の `.env` はコミットしないこと。

# サーバーのポート番号
PORT=4000

# MongoDB 接続URI
MONGODB_URI=mongodb+srv://<ユーザー名>:<パスワード>@<クラスター>.mongodb.net/?retryWrites=true&w=majority&appName=<アプリ名>

# Gemini API Key（防災アドバイス生成用 / Google AI Studio で取得）
# 使用モデル: gemini-2.5-flash-lite
# 未設定時は LLM アドバイスが無効になり、ルールベースフォールバックのみ動作する
GEMINI_API_KEY=取得したAPIキーをここに貼り付け

# Google Maps API Key（サーバー側利用、任意）
# クライアントには公開しないこと
# GOOGLE_MAPS_API_KEY=取得したAPIキーをここに貼り付け
