# Copy this file to `server/.env` and fill in values. Do NOT commit the real `.env`.

# Server configuration
PORT=4000

# MongoDB 接続URI
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>

# Gemini API Key（防災アドバイス生成用 / Google AI Studio で取得）
# モデル: gemini-2.5-flash-lite
# 未設定時は LLM アドバイスが無効になり、ルールベースフォールバックのみ動作する
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Server-side Google Maps API key (optional)
# Keep this private — do not expose to clients.
# GOOGLE_MAPS_API_KEY=YOUR_SERVER_SIDE_API_KEY
